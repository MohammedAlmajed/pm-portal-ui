# ─────────────────────────────────────────────────────────────────────────────
# pm-portal-ui environment contract
# Copy to `.env.local` for local dev. NEVER commit real secrets.
# Only NEXT_PUBLIC_* vars are exposed to the browser; everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Keycloak (external-actor OIDC) ──────────────────────────────────────────
# Issuer = {authority}/realms/{realm}. Backend (PropertiesManager.Shared) validates
# tokens against this exact issuer + JWKS. Realm is `room`.
KEYCLOAK_ISSUER=http://localhost:8080/realms/room
# Public SPA/portal client. Public client + PKCE (no secret in the browser).
KEYCLOAK_CLIENT_ID=room-portal-spa
# Only set if the portal client is a CONFIDENTIAL client (server-side code exchange).
# Leave empty for public + PKCE.
KEYCLOAK_CLIENT_SECRET=
# Absolute callback URL registered in Keycloak for this app.
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Post-logout redirect.
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login

# ── Session sealing ─────────────────────────────────────────────────────────
# 32+ byte secret used to encrypt the session cookie (jose). Generate:
#   openssl rand -base64 32
PORTAL_SESSION_SECRET=change-me-in-local-and-use-a-real-secret-in-prod
# Cookie name for the sealed portal session.
PORTAL_SESSION_COOKIE=pm_portal_session

# ── Backend gateway (BFF target) ────────────────────────────────────────────
# All backend calls are proxied server-side through the gateway with x-tenant-host.
# Tokens never reach the browser.
GATEWAY_BASE_URL=http://localhost:8080

# ── App ─────────────────────────────────────────────────────────────────────
# The canonical app origin (used to build absolute redirect URIs when behind proxies).
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
